# Database (required)
# Use either POSTGRES_URL or DATABASE_URL (Neon’s dashboard often provides DATABASE_URL).
# Neon: copy the connection string from Project → Dashboard (use the pooled "Transaction"
# string for serverless; "Direct" is fine for drizzle-kit migrate from your machine).
POSTGRES_URL=postgresql://user:password@localhost:5432/database
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Public URL of the app (used in links and callbacks)
BASE_URL=http://localhost:3000

# Google Maps — homepage map (browser key with Maps JavaScript API enabled)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional map ID for Advanced Markers. Omit to use DEMO_MAP_ID (dev). In production, create a
# JavaScript map ID in Google Cloud Console with dark styling and set it here.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# WorkOS AuthKit — required (no other login path)
# https://dashboard.workos.com — enable AuthKit, OAuth providers, redirect URI
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# OpenAI — optional until you use /chat or /api/ai/chat
OPENAI_API_KEY=
# Optional model override (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# E2E / Playwright — optional (never commit real secrets)
# ENABLE_E2E_TEST_AUTH=1 plus TEST_APP_* enables POST /api/e2e/session (password auth) for `pnpm test:e2e`
ENABLE_E2E_TEST_AUTH=
TEST_APP_USERNAME=
TEST_APP_SECRET=

# Vercel Blob — park logo uploads (POST /api/uploads/park-image)
# Connect a Blob store to the project in Vercel → Storage → Blob.
# OIDC (default for new stores): run `vercel link` then `vercel env pull` — pulls BLOB_STORE_ID
# and a short-lived VERCEL_OIDC_TOKEN for local dev. BLOB_WEBHOOK_PUBLIC_KEY is for client uploads only.
# Legacy alternative: BLOB_READ_WRITE_TOKEN (long-lived read/write token).
# BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN=
# BLOB_READ_WRITE_TOKEN=
